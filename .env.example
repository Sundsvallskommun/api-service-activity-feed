# Copy to .env to run locally with docker compose. In Dokploy, set the same variables under the Environment tab.

# Database. DB_PASSWORD is required. Generate one with e.g.: openssl rand -hex 24
# DB_ROOT_PASSWORD is recommended (otherwise it is the same as DB_PASSWORD). Do not change it after the first deploy:
# MariaDB only reads it when the volume is created. DB_PASSWORD may change; db-prepare updates the database user on the
# next deploy.
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# API keys, comma-separated, at least 32 characters each. Generate with: openssl rand -hex 32
# API_KEYS_ADMIN: everything, including loading into the cache (business systems, operations). Required.
# API_KEYS_QUERY: only /{municipalityId}/kundhandelseFragaSynkron (the forwarding service).
API_KEYS_ADMIN=
API_KEYS_QUERY=

# Producer
ACTIVITY_FEED_MUNICIPALITY_ID=2281
ACTIVITY_FEED_PRODUCER_NAME=Referenskommunen
ACTIVITY_FEED_PREFIX=REFKOM
ACTIVITY_FEED_STANDARD_VERSION=6.1

# Load sample activities at startup if the municipality has none (true/false). Demo only.
ACTIVITY_FEED_SEED=false

# Number of backups kept in the mariadb-backups volume (one per deploy)
DB_BACKUP_KEEP=10
